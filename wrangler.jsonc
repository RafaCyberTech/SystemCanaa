{
  "name": "systemcanaa",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "systemcanaa",
      "database_id": "<COLA-O-ID-REAL>"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LICOES",
      "bucket_name": "systemcanaa-licoes"
    }
  ]
}
